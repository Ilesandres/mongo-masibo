# Copia este archivo a `.env` y rellena con tus credenciales reales de MongoDB Atlas.
# RELLENAR SOLO CARACTERES | SOLO letras y números en la contraseña (evitar @, #, $, %).
# NUNCA subir `.env` a Git (ya está en .gitignore).
#
# Nota: config.py lee el `.env` real desde `taller-conexion-mongo/.env`.

# ── MongoDB Atlas ─────────────────────────────────────────
MONGO_URI=mongodb+srv://tu_usuario:tu_contrasena@cluster0.nqcatyw.mongodb.net/?retryWrites=true&w=majority
DB_NAME=HYPERFLIX-BD

# ── Data Lake: local (disco) o Amazon S3 ──────────────────
# "local" = Mongo/data_lake/... | "s3" = s3://{S3_BUCKET}/{S3_PREFIX}/...
DATA_LAKE_BACKEND=local

# Solo se usan cuando DATA_LAKE_BACKEND=s3 (o con subir_data_lake_s3.py).
S3_BUCKET=abp-data-lake-tu-nombre
S3_PREFIX=hyperflix
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu_access_key_id
AWS_SECRET_ACCESS_KEY=tu_secret_access_key
# AWS_SESSION_TOKEN=              # solo si usas credenciales temporales (STS)
# S3_ENDPOINT_URL=                # solo para MinIO u otro S3-compatible (vacío = AWS real)

# ── Data Warehouse en la nube (Fase 10, OPCIONAL) ─────────
# none (por defecto, capa apagada) | bigquery | snowflake
# El proyecto funciona igual con "none": esta capa es aditiva.
DW_BACKEND=none

# --- Google BigQuery (Sandbox gratuita, NO pide tarjeta de crédito) ---
# 1) Activa BigQuery Sandbox en https://console.cloud.google.com BigQuery
# 2) Crea una service account con roles "BigQuery Data Editor" + "Job User"
# 3) Descarga el JSON y pon su ruta aquí (el .json NUNCA se sube a Git)
# BQ_PROJECT=mi-proyecto-gcp
# BQ_DATASET=hyperflix
# BQ_LOCATION=US
# BQ_MAX_BYTES_BILLED=1073741824     # tope por consulta: 1 GB (0 = sin tope)
# GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\credenciales-dw.json

# --- Alternativa: Snowflake (Free Trial 30 días con USD 400 de crédito) ---
# SNOWFLAKE_ACCOUNT=abc12345.us-east-1
# SNOWFLAKE_USER=HYPERFLIX
# SNOWFLAKE_PASSWORD=tu_contrasena
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=HYPERFLIX_DW
# SNOWFLAKE_SCHEMA=PUBLIC
# SNOWFLAKE_ROLE=ACCOUNTADMIN
