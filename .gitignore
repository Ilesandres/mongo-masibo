# ── Secretos ──────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.infra.example
# Credenciales de cloud (service account de BigQuery, etc.)
*-credentials.json
service_account*.json

# ── Documentos guía (contexto base, NO se publican) ──────
taller-conexion-mongo/
*.docx

# ── Memoria interna del proyecto (NO se publica) ─────────
agents/

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.python-version

# ── Datos del laboratorio ─────────────────────────────────
data_lake/raw/*.json
data_lake/processed/*.parquet
data_lake/
*.csv
*.parquet
Mongo/dashboards/
# Excel del catálogo de datos (generado, no se versiona)
Mongo/catalogo_datos/
*.xlsx
# Caché temporal al leer desde S3 (no se versiona)
Mongo/data_lake/.cache_s3/

# ── IaC (secretos y estado de Terraform) ──────────────────
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/crash.log
infra/terraform/tfplan
# Backend remoto (S3) que genera el pipeline de CI/CD o la migración del estado
infra/terraform/backend_override.tf

# ── Pruebas (pytest / CI) ────────────────────────────────
.pytest_cache/
reporte-pruebas.xml
*.tfvars
.env.infra

# ── Logs de los scripts de despliegue ─────────────────────
logs/

# ── Entornos / IDEs ──────────────────────────────────────
.idea/
.vscode/
Thumbs.db
.DS_Store