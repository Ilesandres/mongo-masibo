# Copia este archivo a `.env.infra` para que docker-compose.infra.yml
# lea las credenciales sin exponerlas en el repositorio.
#
# Uso:
#   Copy-Item .env.infra.example .env.infra
#   docker compose -f docker-compose.infra.yml up -d

MINIO_ROOT_USER=hyperflix_admin
MINIO_ROOT_PASSWORD=cambia-este-password-min12